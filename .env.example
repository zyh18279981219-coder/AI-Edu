DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ai_education_design
DB_PASSWORD=ai_education_design
DB_NAME=ai_education_design
DB_CHARSET=utf8mb4
DB_AUTO_MIGRATE=0

# Backend runtime
APP_RELOAD=0
API_READ_CACHE_SECONDS=30
AI_EDUCATION_AUTO_SEED_DEFAULT_COURSE=1
RESOURCE_RECOMMENDER_ONLINE=1
PATH_PLANNER_LLM_ENABLED=0

# CORS, comma-separated. Example:
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://your-domain.example
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=

# OpenAI-compatible LLM configuration. Leave empty to run only non-LLM paths.
model_name=
base_url=
api_key=
embedding_model=

# Optional service settings
RAG_K=4
RAG_USE_MMR=0
RAG_USE_MULTIQUERY=0
GO_JUDGE_URL=
GO_JUDGE_TIMEOUT_SECONDS=10

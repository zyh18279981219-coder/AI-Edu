@startuml
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 18
skinparam ArrowColor #475569
skinparam ArrowThickness 1.5
skinparam activity {
  BorderColor #475569
  BackgroundColor #F8FAFC
  FontColor #111827
}
skinparam partitionBorderColor #CBD5E1
skinparam partitionBackgroundColor #FFFFFF

title 图 3-1 核心模块协作关系图

start

partition "课程底座" {
  :课程数字孪生维护课程图谱、资源和能力映射;
  :教师审核并发布课程底座;
}

partition "学习执行" {
  :学生学习空间读取已发布课程底座;
  fork
    :学生学习资源并使用 5E 智能体;
  fork again
    :学生完成在线测验、作业和代码题;
  fork again
    :行业情报提供岗位能力候选;
  end fork
}

partition "证据与画像" {
  :系统汇聚学习行为、测验、作业、代码题和资源使用证据;
  :学生数字孪生更新掌握状态、章节综合实践能力和风险标签;
}

partition "诊断与行动" {
  :诊断智能体解释薄弱点、证据等级和建议动作;
  fork
    :个性化学习路径生成正式路径节点和补学安排;
  fork again
    :教师智能干预任务包生成草稿;
  end fork
}

partition "教师侧闭环" {
  :教师看板展示班级学情、证据下钻和教学支持画像;
  :教师审核路径建议或干预任务包;
  :学生执行学习安排或干预任务;
  :执行结果回流学习证据，进入下一轮画像和诊断;
}

stop
@enduml

@startuml
!theme plain
title AI-Education 功能模块结构
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 18
skinparam roundcorner 12
skinparam shadowing false
skinparam ArrowColor #4A5568
skinparam rectangle {
  BorderColor #4A5568
  FontColor #1F2937
}

rectangle "课程与行业底座" as base #E8F4FF {
  rectangle "3.1 课程数字孪生\n课程图谱 / 资源 / 能力映射" as m31 #D9ECFF
  rectangle "3.12 行业情报与能力对接\n岗位检索 / 能力提取 / 来源依据" as m312 #D9ECFF
}

rectangle "学生学习证据" as evidence #EAF8EF {
  rectangle "3.2 学生学习空间\n资源学习 / 任务入口 / 进度记录" as m32 #DDF3E5
  rectangle "3.3 在线测验\n知识点小测 / 判分 / 证据回流" as m33 #DDF3E5
  rectangle "3.8 作业与实践评测\n主观题 / 选择题 / 客观题 / 代码题" as m38 #DDF3E5
  rectangle "3.7 5E 教学智能体\n阶段引导 / 互动 / 有效度" as m37 #DDF3E5
  rectangle "3.11 教学互动\n答疑 / 讨论 / 反馈 / 行为记录" as m311 #DDF3E5
}

rectangle "画像诊断路径" as intelligence #FFF4E0 {
  rectangle "3.4 学生数字孪生\n画像 / 掌握度 / 实践能力" as m34 #FFE7B8
  rectangle "3.5 诊断智能体\n原因解释 / 依据等级 / 建议动作" as m35 #FFE7B8
  rectangle "3.6 个性化学习路径\n补学节点 / 任务安排 / 路径调整" as m36 #FFE7B8
}

rectangle "教师决策反馈" as teacher #F2EAFE {
  rectangle "3.10 教师看板与教师数字孪生\n班级学情 / 教师画像 / 证据下钻" as m310 #E8D9FF
  rectangle "3.9 教师智能干预任务包\n草稿生成 / 教师审核 / 结果回流" as m39 #E8D9FF
}

m312 --> m31 : 岗位能力候选
m31 --> m32 : 已发布课程底座
m32 --> m34 : 学习行为
m33 --> m34 : 测验证据
m38 --> m34 : 作业与代码题证据
m37 --> m34 : 5E 互动证据
m311 --> m34 : 互动证据
m34 --> m35 : 学生画像
m35 --> m36 : 诊断结论
m35 --> m310 : 风险与依据
m36 --> m32 : 学习任务
m310 --> m39 : 干预建议
m39 --> m32 : 审核后下发
m39 --> m34 : 完成结果
m310 --> m31 : 课程维护反馈
@enduml

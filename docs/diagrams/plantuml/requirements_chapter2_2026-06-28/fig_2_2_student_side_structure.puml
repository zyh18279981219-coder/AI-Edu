@startuml
!theme plain
title AI-Education 学生端功能结构
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 18
skinparam roundcorner 12
skinparam shadowing false
skinparam ArrowColor #4A5568

rectangle "学生端入口" as student #E8F4FF

rectangle "学习执行" as learn #EAF8EF {
  rectangle "课程首页\n进度 / 待办 / 当前路径" as s1 #DDF3E5
  rectangle "知识点学习页\n课件 / 视频 / 文章 / 资料" as s2 #DDF3E5
  rectangle "在线测验\n开始测验 / 查看解析" as s3 #DDF3E5
  rectangle "作业与代码题\n提交 / 查看评分" as s4 #DDF3E5
}

rectangle "画像反馈" as profile #FFF4E0 {
  rectangle "学生数字孪生\n掌握度 / 薄弱点 / 章节实践能力" as s5 #FFE7B8
  rectangle "诊断说明\n哪里薄弱 / 为什么 / 下一步" as s6 #FFE7B8
  rectangle "职业能力说明\n支撑能力 / 缺口知识点" as s7 #FFE7B8
}

rectangle "学习支持" as support #F2EAFE {
  rectangle "个性化学习路径\n补学 / 复习 / 拓展" as s8 #E8D9FF
  rectangle "5E 学习引导\n探究 / 解释 / 迁移 / 评价" as s9 #E8D9FF
  rectangle "干预任务\n教师确认后的补学任务" as s10 #E8D9FF
  rectangle "教学互动\n提问 / 讨论 / 反馈" as s11 #E8D9FF
}

student --> s1
s1 --> s2
s2 --> s3
s2 --> s4
s3 --> s5 : 测验证据
s4 --> s5 : 作业证据
s5 --> s6 : 画像状态
s6 --> s8 : 补学依据
s8 --> s1 : 任务安排
s9 --> s5 : 过程证据
s10 --> s5 : 完成结果
s11 --> s5 : 辅助证据
s7 ..> s8 : 能力缺口提示
@enduml

@startuml
!theme plain
title AI-Education 教师端功能结构
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 18
skinparam roundcorner 12
skinparam shadowing false
skinparam ArrowColor #4A5568

rectangle "教师端入口" as teacher #E8F4FF

rectangle "课程建设" as course #EAF8EF {
  rectangle "课程图谱维护\n章节 / 小节 / 叶子知识点" as t1 #DDF3E5
  rectangle "课程资源审核\n本地资料 / 外部资源" as t2 #DDF3E5
  rectangle "岗位能力映射\n主要岗位 / 关联岗位 / 支撑强度" as t3 #DDF3E5
}

rectangle "教学评测" as assess #FFF4E0 {
  rectangle "测验查看\n班级正确率 / 知识点表现" as t4 #FFE7B8
  rectangle "作业与代码题\n发布 / 批改 / 终审" as t5 #FFE7B8
  rectangle "5E 与互动\n答疑 / 讨论 / 过程记录" as t6 #FFE7B8
}

rectangle "学情决策" as decision #F2EAFE {
  rectangle "教师看板\n风险学生 / 薄弱知识点 / 证据下钻" as t7 #E8D9FF
  rectangle "教师数字孪生\n六维画像 / 教学行为证据" as t8 #E8D9FF
  rectangle "智能干预任务包\n草稿审核 / 修改 / 下发" as t9 #E8D9FF
}

teacher --> t1
t1 --> t2
t1 --> t3
t2 --> t7 : 资源状态
t3 --> t7 : 能力风险
t4 --> t7 : 测验证据
t5 --> t7 : 作业证据
t6 --> t8 : 教学行为证据
t7 --> t9 : 干预建议
t9 --> t7 : 完成反馈
t8 --> t7 : 教师支持状态
t7 --> t1 : 课程维护建议
@enduml

@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam ArrowColor #555555
skinparam roundcorner 10
top to bottom direction

title 第3章功能模块阅读主线

rectangle "课程底座\n3.1 课程数字孪生\n3.12 行业能力" as course #D6EAF8
rectangle "学生学习执行\n3.2 学习空间\n3.3 在线测验\n3.8 作业评测\n3.7 5E智能体" as learn #D5F5E3
rectangle "学生状态沉淀\n3.4 学生数字孪生" as twin #FCF3CF
rectangle "问题解释\n3.5 诊断智能体" as diag #FADBD8
rectangle "行动安排\n3.6 个性化路径\n3.9 教师干预任务包" as action #E8DAEF
rectangle "教学反馈\n3.10 教师看板与教师数字孪生" as teacher #FDEBD0

course --> learn : 发布课程、资源、能力关系
learn --> twin : 测验、作业、学习记录
twin --> diag : 学生画像与证据
diag --> action : 薄弱点、原因、建议
action --> learn : 补学任务与学习安排
diag --> teacher : 风险学生、证据、建议动作
teacher --> course : 调整资源、作业、课程结构

@enduml

@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam ArrowColor #555555
skinparam roundcorner 10
left to right direction

title 诊断智能体服务边界

rectangle "输入证据" as input #D6EAF8 {
  rectangle "学生画像" as a
  rectangle "测验结果" as b
  rectangle "作业/代码题" as c
  rectangle "资源学习记录" as d
  rectangle "课程图谱" as e
}

rectangle "诊断智能体\n判断哪里薄弱、为什么、依据是否充分" as diag #FADBD8

rectangle "输出去向" as output #D5F5E3 {
  rectangle "学生数字孪生\n补充诊断标签" as o1
  rectangle "个性化路径\n生成补学依据" as o2
  rectangle "教师看板\n风险学生与证据下钻" as o3
  rectangle "教师干预模块\n生成任务包草稿依据" as o4
}

a --> diag
b --> diag
c --> diag
d --> diag
e --> diag
diag --> o1
diag --> o2
diag --> o3
diag --> o4
@enduml

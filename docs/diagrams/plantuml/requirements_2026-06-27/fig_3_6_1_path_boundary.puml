@startuml

!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 18
skinparam ArrowColor #475569
skinparam ArrowThickness 1.4
skinparam activity {
  BorderColor #64748B
  BackgroundColor #F8FAFC
  FontColor #111827
  FontStyle plain
  DiamondBorderColor #F97316
  DiamondBackgroundColor #FFF7ED
  StartColor #16A34A
  EndColor #16A34A
}
skinparam partition {
  BorderColor #CBD5E1
  BackgroundColor #FFFFFF
}
skinparam rectangle {
  RoundCorner 16
  BorderThickness 1.3
}
skinparam note {
  BorderColor #94A3B8
  BackgroundColor #F8FAFC
}

start
:系统读取输入\n学生画像、诊断结论、已发布课程图谱、教师要求;
:系统筛选正式路径候选\n薄弱知识点、课程节点、能力支撑点;
if (候选节点是否属于课程图谱?) then (是)
  :纳入正式学习路径;
else (否)
  :作为外部补充学习项\n不写入正式课程图谱;
endif
if (是否存在教师确认的覆盖关系或能力支撑关系?) then (存在)
  :提高节点优先级;
else (不存在)
  :仅作为普通复习或拓展建议;
endif
:系统匹配资源、小测和作业引用;
if (缺少合适作业或代码练习?) then (是)
  :只向教师端提示补充作业或生成草稿;
else (否)
  :引用教师已发布任务;
endif
:生成路径版本\n正式节点 + 补充学习项 + 任务入口;
:学生执行路径并产生学习证据;
:证据回流画像和诊断智能体;
stop
@enduml

@startuml

!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 18
skinparam ArrowColor #475569
skinparam ArrowThickness 1.4
skinparam activity {
  BorderColor #64748B
  BackgroundColor #F8FAFC
  FontColor #111827
  FontStyle plain
  DiamondBorderColor #F97316
  DiamondBackgroundColor #FFF7ED
  StartColor #16A34A
  EndColor #16A34A
}
skinparam partition {
  BorderColor #CBD5E1
  BackgroundColor #FFFFFF
}
skinparam rectangle {
  RoundCorner 16
  BorderThickness 1.3
}
skinparam note {
  BorderColor #94A3B8
  BackgroundColor #F8FAFC
}

start
:教师在看板选择风险学生或薄弱知识点;
:系统读取诊断结论\n薄弱点、证据、建议动作;
if (诊断依据是否足够?) then (不足)
  :系统提示补充证据\n不生成强干预任务包;
  stop
else (足够)
  :系统生成线上任务包草稿\n补学资源、小测、作业/代码练习、提醒话术;
endif
:教师审核并修改任务包;
if (教师是否确认下发?) then (确认)
  :系统下发线上任务给学生;
  :学生完成任务并提交结果;
  :系统回流结果到学生画像、教师看板和教师数字孪生;
  :教师查看效果并决定继续干预或观察;
else (取消/退回)
  :任务包保持草稿或废弃;
endif
stop
@enduml

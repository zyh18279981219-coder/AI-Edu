@startuml

!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 18
skinparam ArrowColor #475569
skinparam ArrowThickness 1.4
skinparam activity {
  BorderColor #64748B
  BackgroundColor #F8FAFC
  FontColor #111827
  FontStyle plain
  DiamondBorderColor #F97316
  DiamondBackgroundColor #FFF7ED
  StartColor #16A34A
  EndColor #16A34A
}
skinparam partition {
  BorderColor #CBD5E1
  BackgroundColor #FFFFFF
}
skinparam rectangle {
  RoundCorner 16
  BorderThickness 1.3
}
skinparam note {
  BorderColor #94A3B8
  BackgroundColor #F8FAFC
}

start
partition "课程与行业底座" {
  :教师维护课程结构、资源、作业;
  :系统生成课程图谱并绑定外部资源;
  :教师/管理员配置目标岗位;
  :系统形成职业能力-知识点映射;
  :教师审核后发布课程底座;
}
partition "学生学习执行" {
  :学生进入学习空间;
  :学习资源、参与 5E 引导、完成测验与作业;
  :系统采集学习行为、测验、作业、代码题和互动证据;
}
partition "画像、诊断与路径" {
  :学生数字孪生更新画像;
  :诊断智能体判断薄弱点、原因和依据等级;
  :个性化路径生成下一步学习安排;
}
partition "教师决策与反馈" {
  :教师看板展示班级风险、证据下钻和建议动作;
  if (是否需要正式干预?) then (是)
    :3.9 生成干预任务包草稿;
    :教师审核、修改、确认后下发;
  else (否)
    :教师观察或调整教学资源与讲解重点;
  endif
  :学生执行任务并产生新证据;
}
:新证据回流课程状态、学生画像和教师看板;
stop
@enduml

@startuml
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 18
skinparam ArrowColor #475569
skinparam ArrowThickness 1.3
skinparam rectangle {
  RoundCorner 14
  BorderThickness 1.2
}
skinparam component {
  BorderThickness 1.2
}
skinparam database {
  BorderColor #64748B
  BackgroundColor #F8FAFC
}
skinparam activity {
  BorderColor #64748B
  BackgroundColor #F8FAFC
  DiamondBorderColor #F97316
  DiamondBackgroundColor #FFF7ED
}
skinparam partition {
  BorderColor #CBD5E1
  BackgroundColor #FFFFFF
}
skinparam note {
  BorderColor #94A3B8
  BackgroundColor #F8FAFC
}

start
partition "建设阶段" {
  :教师录入课程、章节、小节、知识点;
  :系统校验层级、命名、重复节点;
  :系统生成课程知识图谱;
  :系统按叶子知识点绑定外部资源;
  :教师上传本地资料并创建章节作业;
  :教师/管理员确认主要岗位和关联岗位;
  :系统提取职业能力并匹配叶子知识点;
  if (发现能力缺口?) then (是)
    :系统建议补充知识点;
    :教师决定是否纳入课程图谱;
  endif
  :教师审核资源、作业、能力支撑关系;
  :发布课程底座版本;
}
partition "运行评估阶段" {
  :读取已发布图谱、资源、作业、测验、能力映射;
  :汇总班级学习数据;
  if (证据是否足够?) then (不足)
    :提示补充测验、章节作业或学习记录;
  else (足够)
    :判断知识点掌握、资源覆盖、测评缺口、实践能力、能力支撑风险;
  endif
  :生成课程维护建议;
  :教师确认处理、修改草稿或暂缓观察;
  :需要变更底座时重新发布版本;
}
stop
@enduml

@startuml
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 18
skinparam ArrowColor #475569
skinparam ArrowThickness 1.3
skinparam rectangle {
  RoundCorner 14
  BorderThickness 1.2
}
skinparam component {
  BorderThickness 1.2
}
skinparam database {
  BorderColor #64748B
  BackgroundColor #F8FAFC
}
skinparam activity {
  BorderColor #64748B
  BackgroundColor #F8FAFC
  DiamondBorderColor #F97316
  DiamondBackgroundColor #FFF7ED
}
skinparam partition {
  BorderColor #CBD5E1
  BackgroundColor #FFFFFF
}
skinparam note {
  BorderColor #94A3B8
  BackgroundColor #F8FAFC
}

start
:读取学生画像、诊断结论、课程图谱、教师要求;
:筛选薄弱知识点和相关课程节点;
if (节点属于已发布课程图谱?) then (是)
  :纳入正式路径;
else (否)
  :作为外部补充学习项;
endif
:按掌握度、证据等级、教师确认覆盖关系、职业能力支撑关系排序;
:匹配资源、小测入口和已发布作业;
if (缺少合适任务?) then (是)
  :提示教师补充作业或生成草稿;
else (否)
  :引用已发布任务;
endif
:生成路径版本并保存;
:学生执行路径;
:结果回流画像和诊断;
stop
@enduml

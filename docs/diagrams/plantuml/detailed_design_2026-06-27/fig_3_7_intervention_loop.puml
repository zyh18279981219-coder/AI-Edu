@startuml
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 18
skinparam ArrowColor #475569
skinparam ArrowThickness 1.3
skinparam rectangle {
  RoundCorner 14
  BorderThickness 1.2
}
skinparam component {
  BorderThickness 1.2
}
skinparam database {
  BorderColor #64748B
  BackgroundColor #F8FAFC
}
skinparam activity {
  BorderColor #64748B
  BackgroundColor #F8FAFC
  DiamondBorderColor #F97316
  DiamondBackgroundColor #FFF7ED
}
skinparam partition {
  BorderColor #CBD5E1
  BackgroundColor #FFFFFF
}
skinparam note {
  BorderColor #94A3B8
  BackgroundColor #F8FAFC
}

start
:教师在看板选择风险学生或薄弱知识点;
:系统读取诊断结论和证据等级;
if (依据是否足够?) then (不足)
  :提示补充测验、作业或学习记录;
  stop
else (足够)
  :生成线上任务包草稿\n补学资源 / 小测 / 作业或代码练习 / 提醒话术;
endif
:教师审核、修改、确认;
if (是否下发?) then (是)
  :学生完成线上任务;
  :系统记录结果和完成率;
  :回流学生画像、教师看板、教师数字孪生;
else (否)
  :草稿保留或废弃;
endif
stop
@enduml

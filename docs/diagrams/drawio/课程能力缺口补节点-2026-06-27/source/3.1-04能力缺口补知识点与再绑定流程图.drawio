<mxfile host="app.diagrams.net"><diagram name="图 3-1-4 能力缺口补知识点与再绑定流程图"><mxGraphModel dx="2160" dy="2020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="2020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="3.12 输出职业能力候选&#xa;能力名称 / 来源依据 / 需求强度" style="rounded=1;whiteSpace=wrap;html=1;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;spacing=8;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="50" width="920" height="110" as="geometry"/></mxCell><mxCell id="n2" value="系统匹配已有叶子知识点&#xa;按名称、描述、标签和课程语境匹配" style="rounded=1;whiteSpace=wrap;html=1;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;spacing=8;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="220" width="920" height="120" as="geometry"/></mxCell><mxCell id="n3" value="是否匹配到足够支撑知识点？" style="rounded=1;whiteSpace=wrap;html=1;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;spacing=8;fillColor=#ffedd5;strokeColor=#f97316;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="405" width="740" height="105" as="geometry"/></mxCell><mxCell id="n4" value="生成或重算能力-知识点候选映射&#xa;支撑强度：高 / 中 / 低" style="rounded=1;whiteSpace=wrap;html=1;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;spacing=8;fillColor=#f3e8ff;strokeColor=#7e22ce;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="610" width="720" height="125" as="geometry"/></mxCell><mxCell id="n5" value="教师审核映射&#xa;确认、调整强度或补充知识点" style="rounded=1;whiteSpace=wrap;html=1;fontSize=26;fontFamily=Microsoft YaHei;fontColor=#111827;spacing=8;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="800" width="720" height="120" as="geometry"/></mxCell><mxCell id="n6" value="教师确认后发布新课程底座&#xa;学生端和下游模块读取发布版" style="rou
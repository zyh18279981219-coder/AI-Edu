<mxCell id="title" value="图 3-1 数据库分域关系总览图" style="text;html=1;strokeColor=none;fillColor=none;fontSize=34;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="25" width="1060" height="50" as="geometry"/></mxCell><mxCell id="b1" value="第一层：基础主数据，定义系统对象" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fontStyle=1;align=left;verticalAlign=top;spacing=12;fillColor=#f8f9fa;strokeColor=#d0d7de;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="1660" height="205" as="geometry"/></mxCell><mxCell id="identity" value="用户与授权域
主要表：users、sessions、teacher_student_links
作用：识别学生、教师和师生授权关系" style="rounded=1;whiteSpace=wrap;html=1;fontSize=21;fontFamily=Microsoft YaHei;strokeWidth=2;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="105" y="165" width="400" height="110" as="geometry"/></mxCell><mxCell id="course" value="课程底座域
主要表：courses、course_nodes、resources
作用：定义课程、知识点和资源归属" style="rounded=1;whiteSpace=wrap;html=1;fontSize=21;fontFamily=Microsoft YaHei;strokeWidth=2;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="650" y="165" width="420" height="110" as="geometry"/></mxCell><mxCell id="career" value="职业能力映射域
主要表：career_positions、career_abilities、course_ability_mappings
作用：保存岗位能力与知识点支撑关系" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Microsoft YaHei;strokeWidth=2;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1210" y="165" width="430" height="120" as="geometry"/></mxCell><mxCell id="b2" value="第二层：过程证据，记录学生学习与教师教学过程" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fontStyle=1;align=left;verticalAlign=top;spacing=12;fillColor=#f8f9fa;strokeColor=#d0d7de;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="1660" height="220" as="geometry"/></mxCell><mxCell id="learning" value="学习测评证据域
主要表：quiz_attempts、homework_assignments、homework_submissions
作用：记录测验、作业和代码题结果" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Microsoft YaHei;strokeWidth=2;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="330" y="430" width="470" height="120" as="geometry"/></mxCell><mxCell id="teaching" value="教学行为证据域
主要表：teaching_interaction_events、teacher_intervention_events、teaching_discussion_posts
作用：记录互动、干预、讨论和教研行为" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Microsoft YaHei;strokeWidth=2;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="430" width="500" height="120" as="geometry"/></mxCell><mxCell id="b3" value="第三层：画像、诊断与应用结果，面向学生端和教师端输出" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;fontStyle=1;align=left;verticalAlign=top;spacing=12;fillColor=#f8f9fa;strokeColor=#d0d7de;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="1660" height="300" as="geometry"/></mxCell><mxCell id="student" value="学生数字孪生域
主要表：twin_profiles、twin_profile_nodes、twin_history
作用：沉淀学生画像、知识点状态和历史快照" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Microsoft YaHei;strokeWidth=2;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="140" y="735" width="430" height="120" as="geometry"/></mxCell><mxCell id="diagnosis" value="诊断与路径域
主要表：diagnosis_reports、learning_plans、learning_plan_nodes
作用：保存诊断结论、学习路径和任务安排" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Microsoft YaHei;strokeWidth=2;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="735" width="440" height="120" as="geometry"/></mxCell><mxCell id="teacher" value="教师数字孪生与看板域
主要表：teacher_intervention_events、teaching_research_events、teaching_announcements
作用：支撑教师画像、看板和教学动作闭环" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontFamily=Microsoft YaHei;strokeWidth=2;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1230" y="735" width="460" height="120" as="geometry"/></mxCell><mxCell id="note" value="读图方式：本图展示业务分域和主数据流，不是字段级 ER 图。身份域为所有业务表提供用户和授权约束；课程底座定义学习对象；过程证据回流到学生画像、诊断路径和教师看板。字段级表结构在后续模块章节展开。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=22;fontFamily=Microsoft YaHei;strokeWidth=2;spacing=10;fillColor=#f8f9fa;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="210" y="985" width="1360" height="95" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=20;fontFamily=Microsoft YaHei;strokeWidth=2;entryX=0;entryY=0.5;exitX=1;exitY=0.5;" edge="1" parent="1" source="identity" target="course"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=20;fontFamily=Microsoft YaHei;strokeWidth=2;entryX=0;entryY=0.5;exitX=1;exitY=0.5;" edge="1" parent="1" source="course" target="career"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=20;fontFamily=Microsoft YaHei;strokeWidth=2;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" edge="1" parent="1" source="course" target="learning"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=20;fontFamily=Microsoft YaHei;strokeWidth=2;entryX=0.5;entryY=0;exitX=0.35;exitY=1;" edge="1" parent="1" source="learning" target="student"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=20;fontFamily=Microsoft YaHei;strokeWidth=2;en
        <mxCell id="c1" value="<b>课程与能力底座</b><br>3.1 课程数字孪生<br>3.12 行业情报与能力对接<br>课程/资源/能力关系底座" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E7F1FB;strokeColor=#3B6E95;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#263244;align=center;verticalAlign=middle;spacingTop=18;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="100" y="220" width="390" height="240" as="geometry" /></mxCell><mxCell id="c2" value="<b>学习活动承载</b><br>3.2 学习空间<br>3.3 测验  3.8 作业<br>3.7 5E  3.11 互动" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E6F5EC;strokeColor=#328160;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#263244;align=center;verticalAlign=middle;spacingTop=18;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="545" y="220" width="390" height="240" as="geometry" /></mxCell><mxCell id="c3" value="<b>学习证据沉淀</b><br>学习记录与测验结果<br>作业、代码与互动证据<br>干预执行记录" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4D8;strokeColor=#A6731A;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#263244;align=center;verticalAlign=middle;spacingTop=18;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="990" y="220" width="390" height="240" as="geometry" /></mxCell><mxCell id="c4" value="<b>画像诊断解释</b><br>3.4 学生数字孪生<br>3.5 诊断智能体<br>薄弱点、风险与原因" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBE4E2;strokeColor=#B45B55;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#263244;align=center;verticalAlign=middle;spacingTop=18;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1435" y="220" width="390" height="240" as="geometry" /></mxCell><mxCell id="c5" value="<b>路径与干预行动</b><br>3.6 个性化学习路径<br>3.9 教师智能干预任务包<br>补学、复习、拓展与干预" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEE4FA;strokeColor=#7A5AA7;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#263244;align=center;verticalAlign=middle;spacingTop=18;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1010" y="615" width="390" height="240" as="geometry" /></mxCell><mxCell id="c6" value="<b>教师反馈优化</b><br>3.10 教师看板<br>教师数字孪生<br>课程维护与任务下发" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDECD3;strokeColor=#A96F2C;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#263244;align=center;verticalAlign=middle;spacingTop=18;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="540" y="615" width="390" height="240" as="geometry" /></mxCell><mxCell id="edge1" value="发布底座" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge2" value="形成证据" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge3" value="更新画像" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="edge4" value="诊断转行动" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1630" y="540" /><mxPoint x="1205" y="540" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="审核下发" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=3;endA